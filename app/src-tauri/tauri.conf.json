{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moonlock",
  "version": "0.1.0",
  "identifier": "dev.moonlock.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Moonlock",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 30, "y": 32 },
        "width": 1320,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 740
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Âm lịch cho dev: nhắc rằm, mùng 1, giỗ và chặn deploy ngày kiêng",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
